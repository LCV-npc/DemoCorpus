# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medical_corpus
MONGODB_TEST_DB=pdf_extractor_test

# === Storage ===
UPLOAD_DIR=data/uploads
SCRAPE_DIR=data/scraped_pdfs

# === Limits ===
MAX_FILE_SIZE_MB=50
MAX_YEAR_RANGE=20
UNKNOWN_YEAR_POLICY=skip
# Concurrent issue-metadata checks during OJS discovery (1-6). Keep this
# deliberately small to be considerate of journal websites.
CRAWL_DISCOVERY_WORKERS=3
# Relative paths are resolved from backend/.

# === Logging ===
LOG_LEVEL=INFO

# === Production security ===
# Set ENVIRONMENT=production and use a long random API_KEY. The web UI asks
# an administrator for this key per browser session and never stores it on disk.
ENVIRONMENT=development
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === NER Model (Milestone 5+) ===
NER_MODEL_PATH=

# === LLM (Milestone 8+) ===
LLM_MODEL_PATH=
# Gemini is used only as M9, after direct PDF extraction (M1-M8).
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
# Verify title, authors and abstract in M9 after M1-M8 extraction.
LLM_VALIDATE_ALL_FIELDS=true
# Optional generic OpenAI-compatible fallback.
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_MODEL=gpt-3.5-turbo
